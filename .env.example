# Copy this file to .env and put your real values there.
# Do not commit .env. Git ignores it.

MYSQL_HOST=127.0.0.1
MYSQL_PORT=3306
MYSQL_USER=trip_user
MYSQL_PASSWORD=change_me
MYSQL_DATABASE=trip_settlement
MYSQL_ROOT_PASSWORD=change_me

# 8000 because macOS often uses 5000 (AirPlay).
APP_PORT=8000
FLASK_DEBUG=true
